# ─────────────────────────────────────────────────────────────
#  Copiez ce fichier en .env.local et remplissez les valeurs.
#  Ne mettez JAMAIS de vraies clés dans le dépôt Git.
# ─────────────────────────────────────────────────────────────

# Adresse publique du site, sans slash final (SEO, liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://www.exemple-cabinet.fr
APP_URL=https://www.exemple-cabinet.fr

# ── Base de données ──
# Option A — Vercel (ou tout hébergement sans disque persistant) : base Turso (gratuite)
#   Créer une base sur https://turso.tech, région Europe, puis copier son URL et un jeton.
#   Si ces deux variables sont remplies, elles sont utilisées en priorité.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Option B — serveur classique avec disque : fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/cabinet.db

# ── Espace administrateur (/admin) ──
# Mot de passe : 12 caractères minimum
ADMIN_PASSWORD=
# Secret de session : 32 caractères aléatoires minimum (ex. : openssl rand -base64 48)
SESSION_SECRET=

# ── E-mails (confirmations, rappels, notifications) ──
# Envoi depuis la boîte Gmail du cabinet.
# GMAIL_APP_PASSWORD : « mot de passe d'application » créé dans le compte Google
# (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications).
# Ce n'est PAS le mot de passe habituel du compte. Ne jamais le partager ni le mettre dans Git.
EMAIL_PROVIDER=gmail
GMAIL_USER=lpkine197166@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME="Leopold PIRARD - Kinésithérapie"

# Adresse qui reçoit les nouveaux rendez-vous, annulations et messages du formulaire de contact
ADMIN_EMAIL=lpkine197166@gmail.com

# (Alternative si le cabinet a un jour son propre nom de domaine : resend | brevo | sendgrid)
# EMAIL_PROVIDER=brevo
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM="Cabinet de kinésithérapie <rendez-vous@votre-domaine.fr>"

# ── Tâche planifiée : rappels 24 h avant + purge RGPD ──
# Appeler /api/cron toutes les heures avec l'en-tête  Authorization: Bearer <CRON_SECRET>
# (Sur Vercel, l'appel est automatique : voir vercel.json.)
CRON_SECRET=
# Délai du rappel avant le rendez-vous, en heures (24 par défaut).
# Sur Vercel (offre gratuite, tâche lancée 1 fois par jour vers 18 h) : mettre 27
# pour que tous les rendez-vous du lendemain reçoivent leur rappel la veille.
REMINDER_HOURS_BEFORE=

# ── Anti-robot Cloudflare Turnstile (facultatif) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Téléconsultation (visioconférence Daily — https://www.daily.co) ──
# Sans DAILY_API_KEY, la téléconsultation n'est PAS proposée à la réservation et les liens patients
# affichent « visioconférence pas encore disponible ». Clé : tableau de bord Daily > Developers > API keys.
# À garder secrète : uniquement dans les variables d'environnement (jamais dans Git, jamais côté navigateur).
DAILY_API_KEY=
# (facultatif) autre URL d'API — laisser vide en production
DAILY_API_URL=
# (facultatif) région du serveur vidéo, ex. eu-central-1 (Francfort) ou eu-west-2 (Londres).
# Vérifier la liste des régions disponibles dans la documentation Daily avant de la renseigner.
DAILY_GEO=
